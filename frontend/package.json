{
  "name": "zing-doctor-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "医生决策系统（ICU 抗菌药物管理与临床决策）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\"",
    "audit:ci": "npm audit --omit=dev --audit-level=high"
  },
  "lint-staged": {
    "*.{js,mjs,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.6.8",
    "echarts": "^5.5.1",
    "element-plus": "^2.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.2.0"
  }
}
